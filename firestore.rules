rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App has no login — access control relies on the "sync code" itself
    // being a private, hard-to-guess string (like a shared password).
    // Only documents under /syncs/{code} are reachable; everything else
    // is explicitly denied.
    match /syncs/{code} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
